@startuml JobPortalClassDiagram
!define ABSTRACT abstract
!define ENTITY entity
!define ER_STYLE color:#E1F5FE

title Hệ Thống Thông Tin Tuyển Dụng - Sơ Đồ Lớp (OOP Design)

' Define colors
skinparam classBackgroundColor #E1F5FE
skinparam classArrowColor #01579B
skinparam classBorderColor #01579B
skinparam arrowColor #01579B

' ======================
' BASE CLASSES (Abstract)
' ======================

abstract class BaseModel {
  # id: int <<PK>>
  # created_at: datetime
  # updated_at: datetime
  ---
  + get_id(): int
  + save(): void
  + delete(): void
  + to_dict(): dict
}

abstract class BaseService {
  # db_session: Session
  ---
  + execute(): any
  + validate(): bool
  + handle_error(): void
}

abstract class BaseRepository {
  # model: class
  # db: Session
  ---
  + find_by_id(id): BaseModel
  + find_all(): List[BaseModel]
  + create(data): BaseModel
  + update(id, data): BaseModel
  + delete(id): bool
}

' ======================
' USER & AUTH ENTITIES
' ======================

class User {
  - full_name: str
  - email: str <<UNIQUE>>
  - password_hash: str
  - role: enum[admin, recruiter, candidate]
  - auth_method_preference: enum[password, otp]
  - status: enum[active, locked, pending]
  - email_verified: bool
  - phone: str
  - avatar_url: str
  - last_login_at: datetime
  ---
  + is_active(): bool
  + is_recruiter(): bool
  + is_candidate(): bool
  + is_admin(): bool
  + verify_password(pwd): bool
  + set_password(pwd): void
  + check_is_authenticated(): bool
}

class Company {
  - recruiter_user_id: int <<FK,UNIQUE>>
  - company_name: str
  - tax_code: str
  - website: str
  - address: str
  - description: text
  - logo_url: str
  - industry: str
  ---
  + get_recruiter_id(): int
  + get_job_count(): int
  + add_job(job): void
  + get_active_jobs(): List[JobPosting]
  + is_valid(): bool
}

class CandidateProfile {
  - user_id: int <<FK,UNIQUE>>
  - dob: date
  - gender: str
  - address: str
  - headline: str
  - summary: text
  - current_title: str
  - years_experience: int
  - expected_salary: str
  - desired_location: str
  - education: text
  - experience: text
  - portfolio_url: str
  ---
  + get_user_id(): int
  + get_experience_level(): str
  + is_complete(): bool
  + update_profile(data): void
  + get_summary_text(): str
  + calculate_match_score(job): float
}

class Category {
  - name: str <<UNIQUE>>
  - slug: str <<UNIQUE>>
  - description: str
  - is_active: bool
  ---
  + get_tags(): List[Tag]
  + add_tag(tag): void
  + activate(): void
  + deactivate(): void
  + get_active_tags(): List[Tag]
  + is_valid(): bool
}

class Tag {
  - name: str <<UNIQUE>>
  - slug: str <<UNIQUE>>
  - category_id: int <<FK>>
  - description: str
  - is_active: bool
  ---
  + get_category(): Category
  + activate(): void
  + deactivate(): void
  + get_related_jobs(): List[JobPosting]
  + get_related_resumes(): List[Resume]
  # validate_name(): bool
}

class CvTemplate {
  - name: str <<UNIQUE>>
  - slug: str <<UNIQUE>>
  - summary: str
  - description: text
  - thumbnail_url: str
  - preview_url: str
  - file_format: enum[pdf, docx, both]
  - is_active: bool
  ---
  + generate_resume(data): Resume
  + get_preview_url(): str
  + supports_format(fmt): bool
  + is_available(): bool
}

class Resume {
  - user_id: int <<FK>>
  - title: str
  - source_type: enum[manual, upload]
  - template_name: str
  - original_filename: str
  - stored_path: str
  - file_ext: str
  - mime_type: str
  - raw_text: text
  - structured_json: json
  - generated_pdf_path: str
  - generated_docx_path: str
  - is_primary: bool
  ---
  + get_user_id(): int
  + get_tags(): List[Tag]
  + add_tag(tag): void
  + remove_tag(tag): void
  + generate_pdf(): str
  + generate_docx(): str
  + set_as_primary(): void
  + get_structured_data(): dict
  + is_complete(): bool
  + extract_text_from_file(): str
  # parse_structure(): json
}

class JobPosting {
  - recruiter_user_id: int <<FK>>
  - company_id: int <<FK>>
  - title: str
  - slug: str <<UNIQUE>>
  - summary: str
  - description: text
  - requirements: text
  - responsibilities: text
  - location: str
  - workplace_type: enum[onsite, hybrid, remote]
  - employment_type: enum[full-time, part-time, contract, internship]
  - experience_level: enum[intern, fresher, junior, middle, senior, lead]
  - salary_min: int
  - salary_max: int
  - salary_currency: str
  - vacancy_count: int
  - deadline: date
  - status: enum[draft, published, closed]
  - is_featured: bool
  - published_at: datetime
  ---
  + publish(): void
  + close(): void
  + get_tags(): List[Tag]
  + add_tag(tag): void
  + get_applications(): List[Application]
  + get_application_count(): int
  + is_opened(): bool
  + is_deadline_passed(): bool
  + get_match_candidates(): List[MatchScore]
  + calculate_all_matches(): void
  + is_valid(): bool
  # validate_deadline(): bool
}

class Application {
  - candidate_user_id: int <<FK>>
  - job_id: int <<FK>>
  - resume_id: int <<FK>>
  - cover_letter: text
  - status: enum[submitted, reviewing, interview, accepted, rejected, withdrawn]
  - recruiter_note: text
  - applied_at: datetime
  - <<UNIQUE>> (candidate_user_id, job_id)
  ---
  + get_candidate(): User
  + get_job(): JobPosting
  + get_resume(): Resume
  + is_submitted(): bool
  + can_withdraw(): bool
  + withdraw(): void
  + update_status(status): void
  + set_recruiter_note(note): void
  + is_accepted(): bool
  + is_rejected(): bool
  + send_status_notification(): void
  # validate_transitions(): bool
}

class MatchScore {
  - job_id: int <<FK>>
  - resume_id: int <<FK>>
  - candidate_user_id: int <<FK>>
  - score: float
  - breakdown_json: json
  ---
  + get_job(): JobPosting
  + get_resume(): Resume
  + get_score_percentage(): float
  + get_breakdown(): dict
  + is_high_match(): bool
  + get_skill_match_score(): float
  + get_experience_match_score(): float
  + get_location_match_score(): float
}

class OtpCode {
  - user_id: int <<FK,NULLABLE>>
  - email: str
  - role: enum[admin, recruiter, candidate]
  - purpose: enum[register, login, reset]
  - code_hash: str
  - payload_json: json
  - expires_at: datetime
  - resend_available_at: datetime
  - used_at: datetime
  - attempts: int
  - max_attempts: int
  - request_ip: str
  ---
  + is_expired(): bool
  + is_used(): bool
  + verify_code(code): bool
  + can_resend(): bool
  + increment_attempts(): void
  + mark_as_used(): void
  + get_payload(): dict
  + is_valid(): bool
  # hash_code(code): str
}

class AuditLog {
  - actor_user_id: int <<FK>>
  - action: str
  - entity_type: str
  - entity_id: int
  - before_json: json
  - after_json: json
  - ip_address: str
  ---
  + get_actor(): User
  + get_changes(): dict
  + was_created(): bool
  + was_updated(): bool
  + was_deleted(): bool
  + get_change_summary(): str
  + to_report_entry(): dict
}

' ======================
' JUNCTION TABLES
' ======================

class JobTag_Junction {
  - job_id: int <<PK,FK>>
  - tag_id: int <<PK,FK>>
  ---
  Composite Key: (job_id, tag_id)
}

class ResumeTag_Junction {
  - resume_id: int <<PK,FK>>
  - tag_id: int <<PK,FK>>
  ---
  Composite Key: (resume_id, tag_id)
}

' ======================
' SERVICE CLASSES (Business Logic)
' ======================

class AuthenticationService extends BaseService {
  - user_repo: UserRepository
  - otp_service: OtpService
  ---
  + login(email, password): User
  + register(data): User
  + logout(user): void
  + verify_email(otp, code): User
  - hash_password(pwd): str
  - verify_password(pwd, hash): bool
}

class OtpService extends BaseService {
  - otp_repo: OtpCodeRepository
  - mail_service: MailService
  ---
  + send_otp(email, purpose): OtpSendResult
  + verify_otp(email, code): OtpVerifyResult
  + resend_otp(email): void
  + check_max_attempts(otp_code): bool
  - generate_code(): str
  - hash_code(code): str
  - send_email(email, code): void
}

class ResumeService extends BaseService {
  - resume_repo: ResumeRepository
  - cv_service: CvService
  - tag_repo: TagRepository
  ---
  + create_resume(data): Resume
  + update_resume(id, data): Resume
  + upload_resume_file(file): Resume
  + generate_pdf(resume): str
  + generate_docx(resume): str
  + extract_skills(resume): List[Tag]
  + add_tags(resume_id, tags): void
  + set_primary(resume_id): void
  + delete_resume(resume_id): bool
}

class JobService extends BaseService {
  - job_repo: JobPostingRepository
  - match_service: MatchingService
  - tag_repo: TagRepository
  ---
  + create_job(data): JobPosting
  + publish_job(job_id): void
  + close_job(job_id): void
  + add_tags(job_id, tags): void
  + get_recommended_jobs(limit): List[JobPosting]
  + search_jobs(filters): List[JobPosting]
  + get_job_analytics(job_id): dict
  # validate_job_data(data): bool
}

class ApplicationService extends BaseService {
  - app_repo: ApplicationRepository
  - match_service: MatchingService
  - mail_service: MailService
  ---
  + submit_application(candidate_id, job_id, resume_id): Application
  + update_app_status(app_id, status): void
  + withdraw_application(app_id): void
  + set_recruiter_note(app_id, note): void
  + get_applications_for_job(job_id): List[Application]
  + get_candidate_applications(candidate_id): List[Application]
  + send_status_notification(app): void
  # validate_application(candidate_id, job_id): bool
}

class MatchingService extends BaseService {
  - match_score_repo: MatchScoreRepository
  - resume_repo: ResumeRepository
  - job_repo: JobPostingRepository
  ---
  + calculate_match_score(job_id, resume_id): MatchScore
  + calculate_all_matches(job_id): void
  + get_top_candidates(job_id, limit): List[MatchScore]
  + get_recommended_jobs(resume_id, limit): List[MatchScore]
  - score_skills_match(job_tags, resume_tags): float
  - score_experience_match(job, profile): float
  - score_location_match(job, profile): float
}

class MailService extends BaseService {
  ---
  + send_otp_email(email, code): bool
  + send_app_status_email(app): bool
  + send_interview_invitation(app): bool
  + send_job_posted_notification(recruiter, job): bool
  - format_template(template_name, data): str
  - send_email(to, subject, body): bool
}

class StorageService extends BaseService {
  ---
  + upload_file(file, path): str
  + delete_file(path): bool
  + get_file(path): bytes
  + generate_pdf(data): bytes
  + generate_docx(data): bytes
  - validate_file_type(file): bool
  - get_storage_path(): str
}


' ======================
' REPOSITORY CLASSES (Data Access)
' ======================

class UserRepository extends BaseRepository {
  ---
  + find_by_email(email): User
  + find_by_role(role): List[User]
  + find_active_users(): List[User]
  + find_by_phone(phone): User
  + update_last_login(user_id): void
  + lock_user(user_id): void
  + unlock_user(user_id): void
}

class CompanyRepository extends BaseRepository {
  ---
  + find_by_recruiter(recruiter_id): Company
  + search_by_industry(industry): List[Company]
  + get_company_stats(company_id): dict
}

class ResumeRepository extends BaseRepository {
  ---
  + find_by_user(user_id): List[Resume]
  + find_primary_resume(user_id): Resume
  + find_by_source_type(user_id, type): List[Resume]
  + get_resume_with_tags(resume_id): Resume
}

class JobPostingRepository extends BaseRepository {
  ---
  + find_by_status(status): List[JobPosting]
  + find_active_jobs(): List[JobPosting]
  + find_by_recruiter(recruiter_id): List[JobPosting]
  + find_by_location(location): List[JobPosting]
  + search(filters): List[JobPosting]
  + find_published_jobs(): List[JobPosting]
  + get_featured_jobs(limit): List[JobPosting]
}

class ApplicationRepository extends BaseRepository {
  ---
  + find_by_job(job_id): List[Application]
  + find_by_candidate(candidate_id): List[Application]
  + find_by_status(status): List[Application]
  + find_application(candidate_id, job_id): Application
  + exists_application(candidate_id, job_id): bool
  + get_application_stats(): dict
}

class MatchScoreRepository extends BaseRepository {
  ---
  + find_by_job(job_id): List[MatchScore]
  + find_by_resume(resume_id): List[MatchScore]
  + find_match(job_id, resume_id): MatchScore
  + find_top_candidates(job_id, limit): List[MatchScore]
  + find_recommended_jobs(resume_id, limit): List[MatchScore]
  + get_average_score(job_id): float
}

class TagRepository extends BaseRepository {
  ---
  + find_by_category(category_id): List[Tag]
  + find_active_tags(): List[Tag]
  + find_by_name(name): Tag
  + find_job_tags(job_id): List[Tag]
  + find_resume_tags(resume_id): List[Tag]
}

class CategoryRepository extends BaseRepository {
  ---
  + find_active_categories(): List[Category]
  + find_by_slug(slug): Category
  + get_category_with_tags(category_id): Category
}

class OtpCodeRepository extends BaseRepository {
  ---
  + find_by_email_purpose(email, purpose): OtpCode
  + find_pending(email): OtpCode
  + find_by_ip_address(ip): List[OtpCode]
  + cleanup_expired(): int
}

class AuditLogRepository extends BaseRepository {
  ---
  + find_by_actor(actor_id): List[AuditLog]
  + find_by_entity(entity_type, entity_id): List[AuditLog]
  + find_by_action(action): List[AuditLog]
  + find_by_ip_address(ip): List[AuditLog]
  + get_daily_activity(): dict
}

class CvTemplateRepository extends BaseRepository {
  ---
  + find_active_templates(): List[CvTemplate]
  + find_by_format(format): List[CvTemplate]
  + find_by_slug(slug): CvTemplate
}

